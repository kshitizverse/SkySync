# ============================================================
# SkySync Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control.
# ============================================================

# --- Telegram API (required) ---
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your-api-id
TELEGRAM_API_HASH=your-api-hash

# --- Flask Configuration ---
# "production" for deployment. "development" for local testing only.
APP_ENV=production
# Must be False in production.
FLASK_DEBUG=False
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# --- Server ---
# Bind address. Use 0.0.0.0 for Docker/production.
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# --- Telegram Storage Target ---
# "me" = Saved Messages. Or a chat title/username/ID.
TELEGRAM_TARGET_CHAT=me

# --- Application ---
# Max upload size in bytes (default 100MB)
MAX_FILE_SIZE=104857600

# --- CORS ---
# Production: set to your domain(s), comma-separated.
# Example: https://mysync.example.com
CORS_ORIGINS=https://your-domain.com

# --- Rate Limiting ---
# Redis URL for distributed rate limiting in production.
# Without Redis, rate limits are in-memory only.
# REDIS_URL=redis://localhost:6379/0

# --- Public URL ---
# Required for share links. Include protocol, no trailing slash.
# Example: https://mysync.example.com
# PUBLIC_BASE_URL=https://your-domain.com
